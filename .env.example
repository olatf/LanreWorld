# Copy to .env.local for local development. Nothing here is required.

# Public URL of the deployed site (used for social previews).
# On Vercel this is detected automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: skips looking up the channel ID from the @handle.
# Find it at youtube.com/account_advanced while signed in, or leave empty.
YOUTUBE_CHANNEL_ID=
